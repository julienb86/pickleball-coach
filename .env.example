# .env: the main database, used by builds, `eas update` and `npm run start:prod`.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# .env.development.local (not committed): the test database, loaded first by
# `npx expo start`. Same two variables with the test project's values, plus:
#   EXPO_PUBLIC_APP_ENV=test
# which shows the orange "base de test" markers in the app.
